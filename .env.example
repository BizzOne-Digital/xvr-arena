# ------------------------------------------------------------------
# XVR website – environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings → Environment Variables. Never commit real values.
# ------------------------------------------------------------------

# Public URL of the site (used in emails, Stripe redirects, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.xvr.ca

# MongoDB Atlas connection string (required for bookings, admin, waivers, uploads)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xvr?retryWrites=true&w=majority

# One-time token that allows creating the first owner account at /admin.
# Use a long random value (16+ chars). Remove or rotate after setup.
ADMIN_SETUP_TOKEN=

# Stripe (payments). Leave empty to take bookings as "requests" that staff approve.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (transactional emails). Leave empty to disable sending (emails are logged as skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XVR <bookings@xvr.ca>"

# Comma-separated admin notification recipients (in addition to those set in Admin → Settings)
ADMIN_NOTIFY_EMAILS=

# Secret for the scheduled maintenance endpoint (/api/cron). Vercel Cron sends it automatically.
CRON_SECRET=

# Optional: Google Maps Embed API key (the contact map works without it)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
